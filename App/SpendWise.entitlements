<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Firebase Auth keeps the signed-in user in the keychain; without this the simulator says
	     SecItemAdd (-34018) "A required entitlement isn't present". -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.unes.spendwise</string>
	</array>
</dict>
</plist>
